# ─────────────────────────────────────────────────────────────
# Bench（工位）· 环境变量
# cp .env.example .env 后填写。所有密钥只在平台侧使用，
# 绝不注入沙箱（PRD 6.4：secrets 沙箱内不注入任何平台凭据）。
# ─────────────────────────────────────────────────────────────

# ── 数据层：Supabase ──────────────────────────────────────────
# Postgres 直连串（Supabase 控制台 → Project Settings → Database → Connection string）
# 注意用 postgresql+asyncpg:// 前缀
BENCH_DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase Storage（产物上传与签名 URL）
BENCH_SUPABASE_URL=https://PROJECT.supabase.co
BENCH_SUPABASE_SERVICE_KEY=
BENCH_STORAGE_BUCKET=bench-artifacts
# 下载签名 URL 有效期（秒），PRD R6 要求 1 小时
BENCH_SIGNED_URL_TTL=3600

# ── 队列 ─────────────────────────────────────────────────────
BENCH_REDIS_URL=redis://localhost:6379/0

# ── 模型（PRD 6.5：模型名与 base_url 走环境变量）──────────────
BENCH_LLM_BASE_URL=https://api.deepseek.com
BENCH_LLM_API_KEY=
BENCH_LLM_MODEL=deepseek-v4-flash
# 思考模式默认开启；成本敏感的 step（标题生成）代码内显式关闭
BENCH_LLM_THINKING=true
# 叙述性生成用低 temperature（R0.6）
BENCH_LLM_TEMPERATURE=0.1
BENCH_PROMPT_VERSION=v1

# ── 沙箱（PRD 6.4）────────────────────────────────────────────
# e2b   = E2B 托管 Firecracker microVM（默认，生产与探索轨唯一允许的实现）
# local = 本地子进程，**无隔离**，仅供 fixtures 回归与 CI；硬拒绝探索轨代码
BENCH_SANDBOX=e2b
E2B_API_KEY=
# E2B template id，由 sandbox/e2b.Dockerfile 构建（见 docs/runbook.md）
BENCH_E2B_TEMPLATE=bench-python-312
# 出网不是环境变量控制的：runner 建沙箱时默认 allow_internet_access=False，
# 要放行必须在 skill.yaml 的 limits.network_allowlist 里显式写域名。

# 资源硬上限（skill 可在上限内下调，不可上调）
BENCH_SANDBOX_TIMEOUT_S=300
BENCH_SANDBOX_MEMORY_MB=1024
BENCH_SANDBOX_DISK_MB=2048
BENCH_SANDBOX_CPUS=1
BENCH_SANDBOX_PIDS=128

# ── 平台 ─────────────────────────────────────────────────────
BENCH_SKILLS_DIR=../../skills
# v1 不做认证：所有请求归属该用户；接入 Auth 后由 JWT 覆盖
BENCH_DEV_USER_ID=00000000-0000-0000-0000-000000000001
BENCH_CARD_TIMEOUT_HOURS=24
BENCH_ARTIFACT_RETENTION_DAYS=30
BENCH_CORS_ORIGINS=http://localhost:3000

# ── 前端 ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
